# Documentation only. Set these in your host's private environment settings.
# Never put API keys in index.html, git, screenshots or public messages.
VANTIX_ENV=production
HOST=0.0.0.0
PORT=8000
VANTIX_PUBLIC_URL=https://YOUR-SITE.onrender.com
LIBSQL_URL=libsql://YOUR-DATABASE.turso.io
LIBSQL_AUTH_TOKEN=
BREVO_API_KEY=
MAIL_FROM=
SUPPORT_EMAIL=
ADMIN_EMAILS=
SEC_USER_AGENT=VANTIX your-real-contact@example.com
# Read-only GMGN market/trending data. Never add a trading private key to VANTIX.
GMGN_API_KEY=
# Set only after confirming each account's free plan and paid upgrade settings.
FREE_ACCOUNTS_CONFIRMED=0
# Optional AI: only configured + explicitly enabled providers are called.
OPENROUTER_API_KEY=
OPENROUTER_FREE_ONLY=0
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
GROQ_API_KEY=
GROQ_FREE_TIER_CONFIRMED=0
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=0
# NVIDIA hosted free access: development/testing only; ignored in production.
NVIDIA_API_KEY=
NVIDIA_DEVELOPMENT_ENABLED=0
